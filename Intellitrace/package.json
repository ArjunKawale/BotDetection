{
  "name": "intellitrace",
  "version": "1.0.0",
  "description": "Reddit Bot Detector",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.intellitrace.botdetector",
    "productName": "Intellitrace",
    "files": [
      "**/*",
      "!Scrapingtool/**/*"
    ],
    "extraResources": [
      {
        "from": "Scrapingtool",
        "to": "Scrapingtool",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}